<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources cleared on purpose. Used by build/publish.ps1 when nuget.org is
  unreachable: restore then succeeds from the global package cache alone, provided
  every package the build needs has already been downloaded once.

  This file is never the default. Ordinary builds use the normal configuration.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
