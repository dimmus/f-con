<Window x:Class="FCon.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCon" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        Icon="pack://application:,,,/Assets/fcon.ico">
    <StackPanel Margin="22">
        <TextBlock x:Name="DescriptionText" Style="{StaticResource Body}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,12" />

        <TextBox x:Name="InputBox" MinHeight="34" MaxHeight="260"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Width="94" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="OK" IsDefault="True" Width="94" Style="{StaticResource AccentButton}"
                    Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
