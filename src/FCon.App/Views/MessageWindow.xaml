<Window x:Class="FCon.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCon" SizeToContent="Height" Width="500"
        MinHeight="170" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        Icon="pack://application:,,,/Assets/fcon.ico">

    <Border Padding="22,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="Badge" Width="22" Height="22" CornerRadius="11"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeGlyph" Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="11,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Read-only rather than a label so the user can select and copy an error. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <TextBox x:Name="BodyText" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" TextWrapping="Wrap"
                         Foreground="{DynamicResource Text.Secondary}"
                         Padding="0" VerticalContentAlignment="Top" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CopyButton" Content="Copy" Width="90" Margin="0,0,8,0"
                        Style="{StaticResource GhostButton}" Click="Copy_Click" />
                <Button x:Name="SecondaryButton" Content="Cancel" Width="96" Margin="0,0,8,0"
                        IsCancel="True" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Content="OK" Width="96" IsDefault="True"
                        Style="{StaticResource AccentButton}" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
