<Window x:Class="FCon.App.Views.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:FCon.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KVN" Height="620" Width="780" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        Icon="pack://application:,,,/Assets/fcon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="4">
            <TextBox x:Name="ContentBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                     FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" TextWrapping="NoWrap" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:T Copy}" Width="94" Margin="0,0,8,0" Click="Copy_Click" />
            <Button Content="{loc:T Close}" Width="94" IsCancel="True" IsDefault="True"
                    Style="{StaticResource AccentButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
