<Window x:Class="FCon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FCon.App.Views"
        Title="FCon" Height="720" Width="1160" MinHeight="560" MinWidth="940"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/fcon.ico">

    <Window.Resources>
        <v:EqualsToVisibilityConverter x:Key="EqVis" />
        <v:EqualsToBoolConverter x:Key="EqBool" />
        <v:BoolToVisibilityConverter x:Key="BoolVis" />
        <v:InverseBoolConverter x:Key="NotBool" />
        <v:StringToVisibilityConverter x:Key="StrVis" />
        <v:GradeBrushConverter x:Key="GradeBrush" />
        <v:StateBrushConverter x:Key="StateBrush" />
        <v:EnumLabelConverter x:Key="EnumLabel" />

        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================== Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource Surface.Rail}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,12">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                        <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FCon" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavItem}" Content="Servers" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=servers}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Subscriptions" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=subs}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Routing" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=routing}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Log" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=log}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Settings" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=settings}" />
                </StackPanel>

                <!-- ============================================ Connection card -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="12,12,12,14" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center"
                                     Fill="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding ActiveServerName}" Style="{StaticResource Caption}"
                                   Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveServerName}" />

                        <TextBlock Text="{Binding LinkQualityText}" Margin="0,3,0,0" FontSize="11.5"
                                   Foreground="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />

                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   ToolTip="{Binding StatusDetail}"
                                   Visibility="{Binding StatusDetail, Converter={StaticResource StrVis}}" />

                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                                Style="{StaticResource LiftedButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" />

                        <Button Content="Connect to best" Command="{Binding ConnectBestCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                ToolTip="Pick the server with the best measured record and connect to it." />

                        <TextBlock Text="{Binding ListenerSummary}" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================================================ Servers page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}"
                  Visibility="{Binding SelectedPage, Converter={StaticResource EqVis}, ConverterParameter=servers}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="Servers" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                    <Grid DockPanel.Dock="Right" Width="240" Margin="12,0,0,0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="Filter by name, address, protocol or transport" />
                        <TextBlock Text="Search servers" Style="{StaticResource Caption}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Text.Disabled}"
                                   Visibility="{Binding SearchText, Converter={StaticResource StrVis},
                                                ConverterParameter=invert}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <Path Style="{StaticResource Spinner}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock />
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button Content="Add" Command="{Binding AddServerCommand}" Margin="0,0,8,8" />
                    <Button Content="Import from clipboard" Command="{Binding ImportFromClipboardCommand}" Margin="0,0,8,8"
                            ToolTip="Or press Ctrl+V anywhere: share links are imported, a subscription address is added and fetched." />
                    <Button Content="Paste links..." Command="{Binding ImportFromTextCommand}" Margin="0,0,8,8" />
                    <Button Content="Test all" Command="{Binding TestAllCommand}" Margin="0,0,8,8" />
                    <Button Content="Test selected" Command="{Binding TestSelectedCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=ServerGrid}" Margin="0,0,8,8" />
                    <Button Content="Real delay" Command="{Binding TestThroughTunnelCommand}" Margin="0,0,8,8" />
                    <Button Content="Speed test" Command="{Binding SpeedTestCommand}" Margin="0,0,8,8"
                            ToolTip="Measure download throughput through the active tunnel." />
                    <Button Content="Sort by latency" Command="{Binding SortByLatencyCommand}" Margin="0,0,8,8" />
                    <Button Content="Sort by record" Command="{Binding SortByQualityCommand}" Margin="0,0,8,8"
                            ToolTip="Rank by measured reliability and latency together, not just the last ping." />
                    <Button Content="Remove duplicates" Command="{Binding DeduplicateCommand}" Margin="0,0,8,8" />
                    <Button Content="Delete" Command="{Binding DeleteServersCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=ServerGrid}" Margin="0,0,8,8" />
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DataGrid x:Name="ServerGrid" ItemsSource="{Binding Servers}"
                              SelectedItem="{Binding SelectedServer}"
                              MouseDoubleClick="ServerGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" Command="{Binding ConnectToCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <Separator />
                                <MenuItem Header="Edit..." Command="{Binding EditServerCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateServerCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="Copy share link" Command="{Binding CopyLinkCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="Show generated config" Command="{Binding ShowGeneratedConfigCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="26">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Center"
                                                 Fill="{DynamicResource Accent}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolLabel}" Width="110" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="1.6*" />
                            <DataGridTextColumn Header="Stack" Binding="{Binding Stack}" Width="1.3*" />
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="1*" />

                            <DataGridTemplateColumn Header="Latency" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyText}"
                                                   Foreground="{Binding LatencyGrade, Converter={StaticResource GradeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Record" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QualityText}"
                                                   ToolTip="{Binding QualityDetail}"
                                                   Foreground="{Binding QualityGrade, Converter={StaticResource GradeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ========================================== Subscriptions page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Subscriptions}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=subs}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="Subscriptions" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button Content="Add subscription" Command="{Binding AddCommand}" Margin="0,0,8,8" />
                    <Button Content="Update all" Command="{Binding UpdateAllCommand}" Margin="0,0,8,8" />
                    <Button Content="Update selected" Command="{Binding UpdateSelectedCommand}" Margin="0,0,8,8" />
                    <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,8,8" />
                    <Button Content="Edit URL" Command="{Binding EditUrlCommand}" Margin="0,0,8,8" />
                    <Button Content="Fetch via tunnel" Command="{Binding ToggleProxyFetchCommand}" Margin="0,0,8,8"
                            ToolTip="Fetch this subscription through the running proxy instead of directly." />
                    <Button Content="Activate / deactivate" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,8"
                            ToolTip="Deactivating hides this list's servers and stops them being chosen, without deleting them or losing their measured record." />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="52">
                        <!-- A deactivated list stays visible, just visibly out of play. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="Uncheck to take this list's servers out of use. Nothing is deleted." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Name" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Ships with FCon. Can be deactivated or renamed, not removed."
                                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="built-in" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Servers" Binding="{Binding NodeCount}" Width="70" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdatedText}" Width="130" />

                            <DataGridTemplateColumn Header="Quota" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    Visibility="{Binding HasQuota, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding QuotaText}" Style="{StaticResource Caption}" />
                                            <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding QuotaFraction, Mode=OneWay}"
                                                         Foreground="{DynamicResource Accent}"
                                                         Background="{DynamicResource Surface.Hover}"
                                                         BorderThickness="0" />
                                            <TextBlock Text="{Binding ExpiryText}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ================================================ Routing page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Routing}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=routing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Routing" Style="{StaticResource Heading}" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode" VerticalAlignment="Center" Width="130" />
                            <ComboBox Width="260" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </StackPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <CheckBox Content="Bypass private networks" IsChecked="{Binding BypassPrivateNetworks}"
                                      Margin="0,0,22,8" />
                            <CheckBox Content="Bypass Microsoft services" IsChecked="{Binding BypassMicrosoftServices}"
                                      Margin="0,0,22,8" />
                            <CheckBox Content="Block ads" IsChecked="{Binding BlockAds}" Margin="0,0,22,8" />
                            <CheckBox Content="Block QUIC" IsChecked="{Binding BlockQuic}" Margin="0,0,22,8"
                                      ToolTip="Forces browsers back to TLS, which sniffs and routes more reliably." />
                            <CheckBox Content="Resolve domains for IP rules" IsChecked="{Binding ResolveDomainsForIpRules}"
                                      Margin="0,0,22,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,10,0">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="4,8,4,2">
                                <Button Content="Add" Command="{Binding AddRuleCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="Remove" Command="{Binding RemoveRuleCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="Up" Command="{Binding MoveUpCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="Down" Command="{Binding MoveDownCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="Reset" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource GhostButton}" />
                            </WrapPanel>
                            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Enabled}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Action}" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                       Margin="25,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Rule name" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="Action" Style="{StaticResource SectionLabel}" />
                                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                                          HorizontalAlignment="Left" Width="200" />

                                <TextBlock Text="Domains (one per line)" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Domains, UpdateSourceTrigger=LostFocus}" Height="110"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Plain suffix, or full: / keyword: / regexp: / geosite: prefixes." />

                                <TextBlock Text="IP rules (one per line)" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Ips, UpdateSourceTrigger=LostFocus}" Height="90"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="CIDR, bare IP, or geoip: entries." />

                                <TextBlock Text="Ports" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Ports, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Comma separated. Ranges use a hyphen, e.g. 8000-9000." />

                                <TextBlock Text="Processes" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Processes, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Executable names, e.g. chrome.exe, Discord.exe" />

                                <TextBlock Text="Protocols" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Protocols, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Sniffed protocols: http, tls, quic, bittorrent, dns" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================================================== Log page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Logs}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Log" Style="{StaticResource Heading}" />

                <DockPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button DockPanel.Dock="Right" Content="Save..." Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyAllCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Errors only" IsChecked="{Binding ErrorsOnly}"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Filter log lines" />
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource Text.Disabled}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Message}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- =============================================== Settings page -->
            <ScrollViewer Margin="20,18,20,12" VerticalScrollBarVisibility="Auto" Style="{StaticResource AnimatedPage}" DataContext="{Binding Settings}"
                          Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                                       Converter={StaticResource EqVis}, ConverterParameter=settings}">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Settings" Style="{StaticResource Heading}" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock Text="ENGINE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Proxy core" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Traffic capture" VerticalAlignment="Center"
                                           Margin="0,12,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          Margin="0,12,0,0" ItemsSource="{Binding TrafficModes}"
                                          SelectedItem="{Binding TrafficMode}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Log level" VerticalAlignment="Center"
                                           Margin="0,12,0,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          Margin="0,12,0,0" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding EngineRows}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,5,11,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{Binding Grade, Converter={StaticResource GradeBrush}}" />

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding StatusLabel}" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Grade, Converter={StaticResource GradeBrush}}"
                                                                   FontSize="11.5" />
                                                        <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                                Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="in use" FontSize="10.5" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                                               ToolTip="{Binding Location}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                                                    <Button Content="{Binding InstallLabel}"
                                                            ToolTip="Fetch the latest stable release from GitHub. The archive is checked against the published SHA-256 before it is installed."
                                                            Command="{Binding DataContext.InstallEngineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis},
                                                                         ConverterParameter=invert}" />
                                                    <Button Content="manual" Style="{StaticResource GhostButton}"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Open the releases page and the engines folder instead."
                                                            Command="{Binding DataContext.GetEngineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding InstallKey}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis},
                                                                         ConverterParameter=invert}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Re-check" Command="{Binding RefreshEngineStatusCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="Open engines folder" Command="{Binding OpenEnginesFolderCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Surface.Raised}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding AdviceGrade, Converter={StaticResource GradeBrush}}" />
                                        <TextBlock Text="{Binding AdviceSummary}" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="REVIEW" Style="{StaticResource SectionLabel}" Margin="0" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Advice}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,5,11,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{Binding Grade, Converter={StaticResource GradeBrush}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nothing to flag. Settings and the selected server look sound."
                                       Style="{StaticResource Caption}"
                                       Visibility="{Binding HasAdvice, Converter={StaticResource BoolVis},
                                                    ConverterParameter=invert}" />

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Apply recommended" Command="{Binding ApplyRecommendedCommand}"
                                        ToolTip="Fix everything that does not need a judgement call." />
                                <Button Content="Re-check" Command="{Binding RefreshAdviceCommand}"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RESILIENCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox Content="Verify traffic on connect" IsChecked="{Binding VerifyOnConnect}"
                                          Margin="0,0,22,8"
                                          ToolTip="A core binds its port even when the server is dead. This proves data actually flows." />
                                <CheckBox Content="Monitor while connected" IsChecked="{Binding ContinuousHealthCheck}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="Reconnect automatically" IsChecked="{Binding AutoReconnect}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="Fail over to another server" IsChecked="{Binding AutoFailover}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="Always start with the best server" IsChecked="{Binding PreferBestServer}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="Switch servers inside the core" IsChecked="{Binding InCoreFailover}"
                                          Margin="0,0,22,8"
                                          ToolTip="Put the best servers into the core as a group, so a failing one is swapped in about a second without restarting the core or dropping other connections. Off: one server per config, restart to change." />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <TextBlock Text="Check every (seconds)" VerticalAlignment="Center"
                                               Style="{StaticResource Caption}" />
                                    <TextBox Width="90" Text="{Binding HealthCheckIntervalSeconds}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Servers in the group" VerticalAlignment="Center"
                                               Style="{StaticResource Caption}"
                                               ToolTip="Every member is measured on the health interval; the cap bounds that traffic." />
                                    <TextBox Width="90" Text="{Binding FailoverPoolSize}" Margin="10,0,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="While connected, real traffic counts as proof the tunnel works; the probe only runs when nothing has flowed. A failed probe is re-checked within seconds, and the running core is asked to switch server before anything is restarted." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="LISTENERS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="SOCKS port" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding SocksPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="HTTP port" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding HttpPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="API port" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding ApiPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Pick free ports" Command="{Binding PickFreePortsCommand}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="Allow LAN connections" IsChecked="{Binding AllowLan}" Margin="0,0,22,8" />
                                <CheckBox Content="Sniff destinations" IsChecked="{Binding EnableSniffing}" Margin="0,0,22,8" />
                                <CheckBox Content="Route by sniffed domain" IsChecked="{Binding RouteByDomain}" Margin="0,0,22,8" />
                            </WrapPanel>
                            <Button Content="Restore Windows proxy settings" Command="{Binding ClearSystemProxyCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DNS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Remote resolver" Style="{StaticResource Caption}" />
                                    <TextBox Width="280" Text="{Binding RemoteDns}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Direct resolver" Style="{StaticResource Caption}" />
                                    <TextBox Width="280" Text="{Binding DirectDns}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Bootstrap" Style="{StaticResource Caption}" />
                                    <TextBox Width="140" Text="{Binding BootstrapDns}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Use fake-IP responses (sing-box)" IsChecked="{Binding FakeIp}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TUN" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Interface name" Style="{StaticResource Caption}" />
                                    <TextBox Width="160" Text="{Binding TunInterfaceName}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Stack" Style="{StaticResource Caption}" />
                                    <ComboBox Width="140" ItemsSource="{Binding TunStacks}" SelectedItem="{Binding TunStack}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="MTU" Style="{StaticResource Caption}" />
                                    <TextBox Width="100" Text="{Binding TunMtu}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="TUN captures every application, including those that ignore the system proxy. It requires sing-box and administrator rights." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox Content="Launch at login" IsChecked="{Binding LaunchAtLogin}" Margin="0,0,22,8" />
                                <CheckBox Content="Start minimised" IsChecked="{Binding StartMinimized}" Margin="0,0,22,8" />
                                <CheckBox Content="Close to tray" IsChecked="{Binding CloseToTray}" Margin="0,0,22,8" />
                                <CheckBox Content="Reconnect last server on start" IsChecked="{Binding AutoStartLastServer}" Margin="0,0,22,8" />
                                <CheckBox Content="Auto-update subscriptions" IsChecked="{Binding AutoUpdateSubscriptions}" Margin="0,0,22,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Update every (hours)" Style="{StaticResource Caption}" />
                                    <TextBox Width="100" Text="{Binding SubscriptionUpdateHours}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Latency test URL" Style="{StaticResource Caption}" />
                                    <TextBox Width="320" Text="{Binding LatencyTestUrl}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="Theme" Style="{StaticResource Caption}" />
                                    <ComboBox Width="140" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open plugins folder"
                                        Command="{Binding OpenPluginsFolderCommand}" Style="{StaticResource GhostButton}" />
                                <Button DockPanel.Dock="Right" Content="Reload"
                                        Command="{Binding RefreshPluginsCommand}" Style="{StaticResource GhostButton}" />
                                <TextBlock Text="PROTOCOL PLUGINS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Schemes}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Engines}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Open data folder"
                                        Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" />
                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= Status bar -->
            <Border Grid.Row="1" Background="{DynamicResource Surface.Rail}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,7">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               Text="{Binding ListenerSummary}" Margin="16,0,0,0" />

                    <!-- Session total: the "how much has moved" half of the readout. -->
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               Text="{Binding TrafficTotalText}" Margin="16,0,0,0"
                               Visibility="{Binding TrafficTotalText, Converter={StaticResource StrVis}}" />

                    <!-- Live rate, in a fixed-width font so the digits do not jitter. -->
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11.5"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{Binding TrafficRateText}" Margin="16,0,0,0"
                               Visibility="{Binding TrafficRateText, Converter={StaticResource StrVis}}" />

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />

                        <!-- Where the traffic actually comes out. Only shown once proven. -->
                        <Border Background="{DynamicResource Accent.Muted}" CornerRadius="9" Padding="8,1"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ExitText, Converter={StaticResource StrVis}}"
                                ToolTip="Reported by the far side of the tunnel, so it doubles as proof the connection is real.">
                            <TextBlock Text="{Binding ExitText}" FontSize="11" VerticalAlignment="Center" />
                        </Border>

                        <!--
                            StatusDetail is deliberately not repeated here. The connection
                            card already carries it in full, and the status bar's job is the
                            one-word state plus the numbers.
                        -->
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
