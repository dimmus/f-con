<Window x:Class="FCon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:FCon.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FCon.App.Views"
        Title="KVN" Height="720" Width="1160" MinHeight="560" MinWidth="940"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/fcon.ico">

    <Window.Resources>
        <v:EqualsToVisibilityConverter x:Key="EqVis" />
        <v:EqualsToBoolConverter x:Key="EqBool" />
        <v:BoolToVisibilityConverter x:Key="BoolVis" />
        <v:InverseBoolConverter x:Key="NotBool" />
        <v:StringToVisibilityConverter x:Key="StrVis" />
        <v:GradeBrushConverter x:Key="GradeBrush" />
        <v:StateBrushConverter x:Key="StateBrush" />
        <v:EnumLabelConverter x:Key="EnumLabel" />

        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================== Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource Surface.Rail}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,12">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KVN" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavItem}" Content="{loc:T Servers}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=servers}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="{loc:T Subscriptions}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=subs}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="{loc:T Routing}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=routing}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="{loc:T Log}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=log}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="{loc:T Settings}" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqBool}, ConverterParameter=settings}" />
                </StackPanel>

                <!-- ============================================ Connection card -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="12,12,12,14" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center"
                                     Fill="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding ActiveServerName}" Style="{StaticResource Caption}"
                                   Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveServerName}" />

                        <TextBlock Text="{Binding LinkQualityText}" Margin="0,3,0,0" FontSize="11.5"
                                   Foreground="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />

                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   ToolTip="{Binding StatusDetail}"
                                   Visibility="{Binding StatusDetail, Converter={StaticResource StrVis}}" />

                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                                Style="{StaticResource LiftedButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" />

                        <Button Content="{loc:T Connect_to_best}" Command="{Binding ConnectBestCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                ToolTip="{loc:T Pick_the_server_with_the_best_measured}" />

                        <TextBlock Text="{Binding ListenerSummary}" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================================================ Servers page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}"
                  Visibility="{Binding SelectedPage, Converter={StaticResource EqVis}, ConverterParameter=servers}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="{loc:T Servers}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                    <Grid DockPanel.Dock="Right" Width="240" Margin="12,0,0,0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="{loc:T Filter_by_name_address_protocol_or_transport}" />
                        <TextBlock Text="{loc:T Search_servers}" Style="{StaticResource Caption}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Text.Disabled}"
                                   Visibility="{Binding SearchText, Converter={StaticResource StrVis},
                                                ConverterParameter=invert}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <Path Style="{StaticResource Spinner}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock />
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button Content="{loc:T Add}" Command="{Binding AddServerCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Import_from_clipboard}" Command="{Binding ImportFromClipboardCommand}" Margin="0,0,8,8"
                            ToolTip="{loc:T Or_press_Ctrl_V_anywhere_share_links}" />
                    <Button Content="{loc:T Paste_links}" Command="{Binding ImportFromTextCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Test_all}" Command="{Binding TestAllCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Test_selected}" Command="{Binding TestSelectedCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=ServerGrid}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Real_delay}" Command="{Binding TestThroughTunnelCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Speed_test}" Command="{Binding SpeedTestCommand}" Margin="0,0,8,8"
                            ToolTip="{loc:T Measure_download_throughput_through_the_active_t}" />
                    <Button Content="{loc:T Sort_by_latency}" Command="{Binding SortByLatencyCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Sort_by_record}" Command="{Binding SortByQualityCommand}" Margin="0,0,8,8"
                            ToolTip="{loc:T Rank_by_measured_reliability_and_latency_togethe}" />
                    <Button Content="{loc:T Remove_duplicates}" Command="{Binding DeduplicateCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Delete}" Command="{Binding DeleteServersCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=ServerGrid}" Margin="0,0,8,8" />
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DataGrid x:Name="ServerGrid" ItemsSource="{Binding Servers}"
                              SelectedItem="{Binding SelectedServer}"
                              MouseDoubleClick="ServerGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T Connect}" Command="{Binding ConnectToCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <Separator />
                                <MenuItem Header="{loc:T Edit}" Command="{Binding EditServerCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="{loc:T Duplicate}" Command="{Binding DuplicateServerCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="{loc:T Copy_share_link}" Command="{Binding CopyLinkCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                                <MenuItem Header="{loc:T Show_generated_config}" Command="{Binding ShowGeneratedConfigCommand}"
                                          CommandParameter="{Binding SelectedServer}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="26">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Center"
                                                 Fill="{DynamicResource Accent}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:T Name}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{loc:T Protocol}" Binding="{Binding ProtocolLabel}" Width="110" />
                            <DataGridTextColumn Header="{loc:T Address}" Binding="{Binding Address}" Width="1.6*" />
                            <DataGridTextColumn Header="{loc:T Stack}" Binding="{Binding Stack}" Width="1.3*" />
                            <DataGridTextColumn Header="{loc:T Group}" Binding="{Binding Group}" Width="1*" />

                            <DataGridTemplateColumn Header="{loc:T Latency}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyText}"
                                                   Foreground="{Binding LatencyGrade, Converter={StaticResource GradeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:T Record}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QualityText}"
                                                   ToolTip="{Binding QualityDetail}"
                                                   Foreground="{Binding QualityGrade, Converter={StaticResource GradeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ========================================== Subscriptions page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Subscriptions}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=subs}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="{loc:T Subscriptions}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button Content="{loc:T Add_subscription}" Command="{Binding AddCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Update_all}" Command="{Binding UpdateAllCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Update_selected}" Command="{Binding UpdateSelectedCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Rename}" Command="{Binding RenameCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Edit_URL}" Command="{Binding EditUrlCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:T Fetch_via_tunnel}" Command="{Binding ToggleProxyFetchCommand}" Margin="0,0,8,8"
                            ToolTip="{loc:T Fetch_this_subscription_through_the_running_prox}" />
                    <Button Content="{loc:T Activate_deactivate}" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,8"
                            ToolTip="{loc:T Deactivating_hides_this_list_s_servers_and}" />
                    <Button Content="{loc:T Remove}" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="52">
                        <!-- A deactivated list stays visible, just visibly out of play. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:T On}" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="{loc:T Uncheck_to_take_this_list_s_servers}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:T Name}" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="{loc:T Ships_with_FCon_Can_be_deactivated_or}"
                                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{loc:T built_in}" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:T Servers}" Binding="{Binding NodeCount}" Width="70" />
                            <DataGridTextColumn Header="{loc:T Updated}" Binding="{Binding LastUpdatedText}" Width="130" />

                            <DataGridTemplateColumn Header="{loc:T Quota}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    Visibility="{Binding HasQuota, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding QuotaText}" Style="{StaticResource Caption}" />
                                            <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding QuotaFraction, Mode=OneWay}"
                                                         Foreground="{DynamicResource Accent}"
                                                         Background="{DynamicResource Surface.Hover}"
                                                         BorderThickness="0" />
                                            <TextBlock Text="{Binding ExpiryText}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:T Status}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ================================================ Routing page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Routing}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=routing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:T Routing}" Style="{StaticResource Heading}" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Mode}" VerticalAlignment="Center" Width="130" />
                            <ComboBox Width="260" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </StackPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <CheckBox Content="{loc:T Bypass_private_networks}" IsChecked="{Binding BypassPrivateNetworks}"
                                      Margin="0,0,22,8" />
                            <CheckBox Content="{loc:T Bypass_Microsoft_services}" IsChecked="{Binding BypassMicrosoftServices}"
                                      Margin="0,0,22,8" />
                            <CheckBox Content="{loc:T Block_ads}" IsChecked="{Binding BlockAds}" Margin="0,0,22,8" />
                            <CheckBox Content="{loc:T Block_QUIC}" IsChecked="{Binding BlockQuic}" Margin="0,0,22,8"
                                      ToolTip="{loc:T Forces_browsers_back_to_TLS_which_sniffs}" />
                            <CheckBox Content="{loc:T Resolve_domains_for_IP_rules}" IsChecked="{Binding ResolveDomainsForIpRules}"
                                      Margin="0,0,22,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,10,0">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="4,8,4,2">
                                <Button Content="{loc:T Add}" Command="{Binding AddRuleCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:T Remove}" Command="{Binding RemoveRuleCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:T Up}" Command="{Binding MoveUpCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:T Down}" Command="{Binding MoveDownCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:T Reset}" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource GhostButton}" />
                            </WrapPanel>
                            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Enabled}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Action}" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                       Margin="25,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Rule_name}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="{loc:T Action}" Style="{StaticResource SectionLabel}" />
                                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                                          HorizontalAlignment="Left" Width="200" />

                                <TextBlock Text="{loc:T Domains_one_per_line}" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Domains, UpdateSourceTrigger=LostFocus}" Height="110"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="{loc:T Plain_suffix_or_full_keyword_regexp_geosite}" />

                                <TextBlock Text="{loc:T IP_rules_one_per_line}" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Ips, UpdateSourceTrigger=LostFocus}" Height="90"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="{loc:T CIDR_bare_IP_or_geoip_entries}" />

                                <TextBlock Text="{loc:T Ports}" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Ports, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:T Comma_separated_Ranges_use_a_hyphen_e}" />

                                <TextBlock Text="{loc:T Processes}" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Processes, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:T Executable_names_e_g_chrome_exe_Discord}" />

                                <TextBlock Text="{loc:T Protocols}" Style="{StaticResource SectionLabel}" />
                                <TextBox Text="{Binding Protocols, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:T Sniffed_protocols_http_tls_quic_bittorrent_dns}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================================================== Log page -->
            <Grid Margin="20,18,20,12" Style="{StaticResource AnimatedPage}" DataContext="{Binding Logs}"
                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource EqVis}, ConverterParameter=log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:T Log}" Style="{StaticResource Heading}" />

                <DockPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button DockPanel.Dock="Right" Content="{loc:T Save}" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{loc:T Copy}" Command="{Binding CopyAllCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{loc:T Clear}" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="{loc:T Auto_scroll}" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="{loc:T Errors_only}" IsChecked="{Binding ErrorsOnly}"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="{loc:T Filter_log_lines}" />
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource Text.Disabled}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Message}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- =============================================== Settings page -->
            <ScrollViewer Margin="20,18,20,12" VerticalScrollBarVisibility="Auto" Style="{StaticResource AnimatedPage}" DataContext="{Binding Settings}"
                          Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window},
                                       Converter={StaticResource EqVis}, ConverterParameter=settings}">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:T Settings}" Style="{StaticResource Heading}" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T ENGINE}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Proxy_core}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Traffic_capture}" VerticalAlignment="Center"
                                           Margin="0,12,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          Margin="0,12,0,0" ItemsSource="{Binding TrafficModes}"
                                          SelectedItem="{Binding TrafficMode}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Log_level}" VerticalAlignment="Center"
                                           Margin="0,12,0,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                          Margin="0,12,0,0" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding EngineRows}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,5,11,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{Binding Grade, Converter={StaticResource GradeBrush}}" />

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding StatusLabel}" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Grade, Converter={StaticResource GradeBrush}}"
                                                                   FontSize="11.5" />
                                                        <Border Background="{DynamicResource Accent.Muted}" CornerRadius="4"
                                                                Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{loc:T in_use}" FontSize="10.5" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                                               ToolTip="{Binding Location}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                                                    <Button Content="{Binding InstallLabel}"
                                                            ToolTip="{loc:T Fetch_the_latest_stable_release_from_GitHub}"
                                                            Command="{Binding DataContext.InstallEngineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis},
                                                                         ConverterParameter=invert}" />
                                                    <Button Content="{loc:T manual}" Style="{StaticResource GhostButton}"
                                                            Margin="6,0,0,0"
                                                            ToolTip="{loc:T Open_the_releases_page_and_the_engines}"
                                                            Command="{Binding DataContext.GetEngineCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding InstallKey}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis},
                                                                         ConverterParameter=invert}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{loc:T Re_check}" Command="{Binding RefreshEngineStatusCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:T Open_engines_folder}" Command="{Binding OpenEnginesFolderCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Surface.Raised}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding AdviceGrade, Converter={StaticResource GradeBrush}}" />
                                        <TextBlock Text="{Binding AdviceSummary}" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T REVIEW}" Style="{StaticResource SectionLabel}" Margin="0" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Advice}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,5,11,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{Binding Grade, Converter={StaticResource GradeBrush}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:T Nothing_to_flag_Settings_and_the_selected}"
                                       Style="{StaticResource Caption}"
                                       Visibility="{Binding HasAdvice, Converter={StaticResource BoolVis},
                                                    ConverterParameter=invert}" />

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{loc:T Apply_recommended}" Command="{Binding ApplyRecommendedCommand}"
                                        ToolTip="{loc:T Fix_everything_that_does_not_need_a}" />
                                <Button Content="{loc:T Re_check}" Command="{Binding RefreshAdviceCommand}"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T RESILIENCE}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox Content="{loc:T Verify_traffic_on_connect}" IsChecked="{Binding VerifyOnConnect}"
                                          Margin="0,0,22,8"
                                          ToolTip="{loc:T A_core_binds_its_port_even_when}" />
                                <CheckBox Content="{loc:T Monitor_while_connected}" IsChecked="{Binding ContinuousHealthCheck}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Reconnect_automatically}" IsChecked="{Binding AutoReconnect}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Fail_over_to_another_server}" IsChecked="{Binding AutoFailover}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Always_start_with_the_best_server}" IsChecked="{Binding PreferBestServer}"
                                          Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Switch_servers_inside_the_core}" IsChecked="{Binding InCoreFailover}"
                                          Margin="0,0,22,8"
                                          ToolTip="{loc:T Put_the_best_servers_into_the_core}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <TextBlock Text="{loc:T Check_every_seconds}" VerticalAlignment="Center"
                                               Style="{StaticResource Caption}" />
                                    <TextBox Width="90" Text="{Binding HealthCheckIntervalSeconds}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Servers_in_the_group}" VerticalAlignment="Center"
                                               Style="{StaticResource Caption}"
                                               ToolTip="{loc:T Every_member_is_measured_on_the_health}" />
                                    <TextBox Width="90" Text="{Binding FailoverPoolSize}" Margin="10,0,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{loc:T While_connected_real_traffic_counts_as_proof}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T LISTENERS}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T SOCKS_port}" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding SocksPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T HTTP_port}" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding HttpPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T API_port}" Style="{StaticResource Caption}" />
                                    <TextBox Width="110" Text="{Binding ApiPort}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="{loc:T Pick_free_ports}" Command="{Binding PickFreePortsCommand}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="{loc:T Allow_LAN_connections}" IsChecked="{Binding AllowLan}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Sniff_destinations}" IsChecked="{Binding EnableSniffing}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Route_by_sniffed_domain}" IsChecked="{Binding RouteByDomain}" Margin="0,0,22,8" />
                            </WrapPanel>
                            <Button Content="{loc:T Restore_Windows_proxy_settings}" Command="{Binding ClearSystemProxyCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T DNS}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Remote_resolver}" Style="{StaticResource Caption}" />
                                    <TextBox Width="280" Text="{Binding RemoteDns}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Direct_resolver}" Style="{StaticResource Caption}" />
                                    <TextBox Width="280" Text="{Binding DirectDns}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Bootstrap}" Style="{StaticResource Caption}" />
                                    <TextBox Width="140" Text="{Binding BootstrapDns}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Content="{loc:T Use_fake_IP_responses_sing_box}" IsChecked="{Binding FakeIp}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T TUN}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Interface_name}" Style="{StaticResource Caption}" />
                                    <TextBox Width="160" Text="{Binding TunInterfaceName}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Stack}" Style="{StaticResource Caption}" />
                                    <ComboBox Width="140" ItemsSource="{Binding TunStacks}" SelectedItem="{Binding TunStack}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T MTU}" Style="{StaticResource Caption}" />
                                    <TextBox Width="100" Text="{Binding TunMtu}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{loc:T TUN_captures_every_application_including_those_t}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T BEHAVIOUR}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox Content="{loc:T Launch_at_login}" IsChecked="{Binding LaunchAtLogin}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Start_minimised}" IsChecked="{Binding StartMinimized}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Close_to_tray}" IsChecked="{Binding CloseToTray}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Reconnect_last_server_on_start}" IsChecked="{Binding AutoStartLastServer}" Margin="0,0,22,8" />
                                <CheckBox Content="{loc:T Auto_update_subscriptions}" IsChecked="{Binding AutoUpdateSubscriptions}" Margin="0,0,22,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Update_every_hours}" Style="{StaticResource Caption}" />
                                    <TextBox Width="100" Text="{Binding SubscriptionUpdateHours}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Latency_test_URL}" Style="{StaticResource Caption}" />
                                    <TextBox Width="320" Text="{Binding LatencyTestUrl}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Theme}" Style="{StaticResource Caption}" />
                                    <ComboBox Width="140" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="{loc:T Language}" Style="{StaticResource Caption}" />
                                    <ComboBox Width="160" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                              DisplayMemberPath="Label" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{loc:T Open_plugins_folder}"
                                        Command="{Binding OpenPluginsFolderCommand}" Style="{StaticResource GhostButton}" />
                                <Button DockPanel.Dock="Right" Content="{loc:T Reload}"
                                        Command="{Binding RefreshPluginsCommand}" Style="{StaticResource GhostButton}" />
                                <TextBlock Text="{loc:T PROTOCOL_PLUGINS}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="6"
                                                Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Schemes}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Engines}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="{loc:T Open_data_folder}"
                                        Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" />
                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= Status bar -->
            <Border Grid.Row="1" Background="{DynamicResource Surface.Rail}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,7">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               Text="{Binding ListenerSummary}" Margin="16,0,0,0" />

                    <!-- Session total: the "how much has moved" half of the readout. -->
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               Text="{Binding TrafficTotalText}" Margin="16,0,0,0"
                               Visibility="{Binding TrafficTotalText, Converter={StaticResource StrVis}}" />

                    <!-- Live rate, in a fixed-width font so the digits do not jitter. -->
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11.5"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{Binding TrafficRateText}" Margin="16,0,0,0"
                               Visibility="{Binding TrafficRateText, Converter={StaticResource StrVis}}" />

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding LinkGrade, Converter={StaticResource GradeBrush}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />

                        <!-- Where the traffic actually comes out. Only shown once proven. -->
                        <Border Background="{DynamicResource Accent.Muted}" CornerRadius="9" Padding="8,1"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ExitText, Converter={StaticResource StrVis}}"
                                ToolTip="{loc:T Reported_by_the_far_side_of_the}">
                            <TextBlock Text="{Binding ExitText}" FontSize="11" VerticalAlignment="Center" />
                        </Border>

                        <!--
                            StatusDetail is deliberately not repeated here. The connection
                            card already carries it in full, and the status bar's job is the
                            one-word state plus the numbers.
                        -->
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
