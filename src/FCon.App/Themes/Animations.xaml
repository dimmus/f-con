<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Motion is used to explain state, not to decorate. Three rules keep it calm:
        transitions are short (under ~250ms), easing is always decelerating so movement
        settles rather than stops dead, and anything that loops is tied to work actually
        being in progress so the UI is still when the app is idle.
    -->

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut" />

    <!-- ==================================================== Page transition -->

    <!--
        Pages are swapped by Visibility rather than reloaded, so the entrance runs from a
        Visibility trigger instead of Loaded, which would only ever fire once.
    -->
    <Style x:Key="AnimatedPage" TargetType="FrameworkElement">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22"
                                             EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                             From="10" To="0" Duration="0:0:0.26"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================= Status pulse -->

    <!--
        The connection dot breathes only while a connect, verify or recovery is running.
        A steady state gets a steady dot, so motion always means something is happening.
    -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="PulseStory">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.55" Duration="0:0:0.7"
                                             EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.55" Duration="0:0:0.7"
                                             EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0.45" Duration="0:0:0.7"
                                             EasingFunction="{StaticResource EaseInOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="PulseStory" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ Spinner -->

    <!--
        Shown while a batch operation runs. An arc rather than a full ring, so the
        rotation is legible at small sizes.
    -->
    <Style x:Key="Spinner" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Data" Value="M 7,1 A 6,6 0 1 1 1.6,4.2" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SpinStory">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                             From="0" To="360" Duration="0:0:0.9"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinStory" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================== Lifted controls -->

    <!--
        A small lift on hover. Scale is kept tiny because the button carries text: any
        more and the glyphs visibly resample.
    -->
    <Style x:Key="LiftedButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.025" Duration="0:0:0.12"
                                             EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.025" Duration="0:0:0.12"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.985" Duration="0:0:0.07" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.985" Duration="0:0:0.07" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================= Card entrance -->

    <Style x:Key="AnimatedCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.3"
                                         EasingFunction="{StaticResource EaseOut}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
