<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces, from furthest back to closest to the user. -->
    <SolidColorBrush x:Key="Surface.Window"   Color="#0F1115" />
    <SolidColorBrush x:Key="Surface.Rail"     Color="#141821" />
    <SolidColorBrush x:Key="Surface.Card"     Color="#181D28" />
    <SolidColorBrush x:Key="Surface.Raised"   Color="#1F2532" />
    <SolidColorBrush x:Key="Surface.Hover"    Color="#252C3B" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#2A3446" />

    <SolidColorBrush x:Key="Border.Subtle"    Color="#242A36" />
    <SolidColorBrush x:Key="Border.Strong"    Color="#333B4A" />
    <SolidColorBrush x:Key="Border.Focus"     Color="#4C8DFF" />

    <SolidColorBrush x:Key="Text.Primary"     Color="#E9EDF5" />
    <SolidColorBrush x:Key="Text.Secondary"   Color="#98A2B8" />
    <SolidColorBrush x:Key="Text.Disabled"    Color="#5A6478" />
    <SolidColorBrush x:Key="Text.OnAccent"    Color="#FFFFFF" />

    <SolidColorBrush x:Key="Accent"           Color="#4C8DFF" />
    <SolidColorBrush x:Key="Accent.Hover"     Color="#6BA1FF" />
    <SolidColorBrush x:Key="Accent.Pressed"   Color="#3A78E0" />
    <SolidColorBrush x:Key="Accent.Muted"     Color="#1E2C45" />

    <SolidColorBrush x:Key="Status.Good"      Color="#3DD68C" />
    <SolidColorBrush x:Key="Status.Warn"      Color="#F5B547" />
    <SolidColorBrush x:Key="Status.Bad"       Color="#F2555A" />
    <SolidColorBrush x:Key="Status.Idle"      Color="#6B7689" />

</ResourceDictionary>
